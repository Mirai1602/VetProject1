<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <persistence-unit name="veterinariaPU">

        <class>com.proyectofinal.veterinarialosarcos.models.Usuario</class>
        <class>com.proyectofinal.veterinarialosarcos.models.Paciente</class>
        <class>com.proyectofinal.veterinarialosarcos.models.Propietario</class>
        <class>com.proyectofinal.veterinarialosarcos.models.Expediente</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5433/Veterinaria"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="Artemis97."/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.PostgreSQLDialect"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

            <!-- Crea/actualiza tablas y columnas automáticamente en cada arranque -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <!-- Si Hibernate no puede aplicar un cambio de estructura, la app avisa al
                 arrancar en lugar de fallar después con un error raro al guardar -->
            <property name="hibernate.hbm2ddl.halt_on_error"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>