<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<!-- Vista exclusiva del administrador: lista de veterinarios y alta de nuevos -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.proyectofinal.veterinarialosarcos.controllers.AdminController"
            stylesheets="@login.css, @pacientes.css"
            styleClass="background"
            prefWidth="1400"
            prefHeight="620">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <center>
        <VBox spacing="16" styleClass="login-card">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- Encabezado -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Veterinarios" styleClass="title"/>
                    <Label fx:id="lblTotal" styleClass="subtitle"/>
                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblAdmin" styleClass="subtitle"/>

                <Button text="Cerrar sesión"
                        onAction="#cerrarSesion"
                        styleClass="link-button"/>
            </HBox>

            <TableView fx:id="tblVeterinarios"
                       styleClass="tabla-pacientes, tabla-veterinarios"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>

                <placeholder>
                    <Label fx:id="lblPlaceholder" styleClass="subtitle"/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="colNombres" text="Nombres"/>
                    <TableColumn fx:id="colApellidos" text="Apellidos"/>
                    <TableColumn fx:id="colCedula" text="Cédula"/>
                    <TableColumn fx:id="colSexo" text="Sexo"/>
                    <TableColumn fx:id="colEdad" text="Edad"/>
                    <TableColumn fx:id="colEmail" text="Email"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono"/>
                    <TableColumn fx:id="colConsultorio" text="Consultorio"/>
                    <TableColumn fx:id="colEspecialidad" text="Especialidad"/>
                    <TableColumn text="Pacientes">
                        <columns>
                            <TableColumn fx:id="colAtendidos" text="Atendidos"/>
                            <TableColumn fx:id="colAtendiendo" text="Atendiendo"/>
                        </columns>
                    </TableColumn>
                    <TableColumn text="Acceso">
                        <columns>
                            <TableColumn fx:id="colUsuario" text="Usuario"/>
                            <TableColumn fx:id="colPassword" text="Contraseña"/>
                        </columns>
                    </TableColumn>
                </columns>
            </TableView>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Doble clic en un veterinario para editarlo"
                       styleClass="subtitle"/>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="Agregar"
                        onAction="#agregar"
                        styleClass="boton-accion"/>

                <Button fx:id="btnEditar"
                        text="Editar"
                        onAction="#editar"
                        styleClass="boton-editar"/>

                <Button fx:id="btnEliminar"
                        text="Eliminar"
                        onAction="#eliminar"
                        styleClass="boton-eliminar"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
