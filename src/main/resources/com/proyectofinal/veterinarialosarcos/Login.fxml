<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.proyectofinal.veterinarialosarcos.controllers.LoginController"
           stylesheets="@login.css"
           styleClass="background">

    <VBox spacing="20"
          alignment="CENTER"
          maxWidth="400"
          styleClass="login-card">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="🐾 ¡Hola de nuevo!"
               styleClass="title"/>

        <Label text="Inicia sesión para cuidar de tus mascotas"
               styleClass="subtitle"/>

        <TextField fx:id="txtUsuario"
                   promptText="Nombre de usuario"
                   styleClass="input"/>

        <PasswordField fx:id="txtPassword"
                       promptText="Contraseña"
                       styleClass="input"/>

        <Label fx:id="lblMensaje"
               wrapText="true"
               visible="false"
               managed="false"/>

        <Button text="Iniciar Sesión"
                onAction="#iniciarSesion"
                defaultButton="true"
                styleClass="login-button"/>

        <!-- No hay registro público: el administrador es quien crea las cuentas -->
        <Label text="¿No tienes cuenta? Pídele al administrador que te registre."
               wrapText="true"
               styleClass="subtitle"/>
    </VBox>

</StackPane>
