<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.proyectofinal.veterinarialosarcos.controllers.RegistroController"
           stylesheets="@login.css"
           styleClass="background">

    <VBox spacing="20"
          alignment="CENTER"
          maxWidth="400"
          styleClass="login-card">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="🐾 Bienvenido!"
               styleClass="title"/>

        <Label text="Regístrate para comenzar"
               styleClass="subtitle"/>

        <TextField
                fx:id="txtUsuario"
                promptText="Nombre de usuario"
                styleClass="input"/>
        <TextField
                fx:id="txtCorreo"
                promptText="Correo electrónico"
                styleClass="input"/>

        <PasswordField fx:id="txtPassword"
                       promptText="Contraseña"
                       styleClass="input"/>

        <PasswordField
                fx:id="txtConfirmPassword"
                promptText="Confirmar contraseña"
                styleClass="input"/>

        <Label fx:id="lblMensaje"
               wrapText="true"
               visible="false"
               managed="false"/>

        <Button
                text="Crear Cuenta"
                onAction="#registrar"
                styleClass="login-button"/>


        <Button
                text="¿Ya tienes cuenta? Iniciar sesión"
                onAction="#mostrarLogin"
                styleClass="link-button"/>
    </VBox>

</StackPane>