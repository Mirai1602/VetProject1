<?xml version="1.0" encoding="UTF-8"?>
<!--
  Historial de consultas de un paciente.
  Se puede abrir y editar con Jaspersoft Studio. Si cambias nombres de campos o
  parámetros, actualiza también utils/ReporteService.java.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="historial_consultas" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="36" bottomMargin="36"
              whenNoDataType="AllSectionsNoDetail">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9" forecolor="#2D3436"/>
    <style name="Etiqueta" style="Base" isBold="true" forecolor="#018081"/>
    <style name="Encabezado" style="Base" isBold="true" forecolor="#FFFFFF" backcolor="#018081" mode="Opaque"/>
    <style name="Fila" style="Base">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#E0F2F1"/>
        </conditionalStyle>
    </style>

    <parameter name="NEGOCIO" class="java.lang.String"/>
    <parameter name="NUM_EXPEDIENTE" class="java.lang.String"/>
    <parameter name="PACIENTE" class="java.lang.String"/>
    <parameter name="ESPECIE" class="java.lang.String"/>
    <parameter name="RAZA" class="java.lang.String"/>
    <parameter name="SEXO" class="java.lang.String"/>
    <parameter name="EDAD" class="java.lang.String"/>
    <parameter name="PROPIETARIO" class="java.lang.String"/>
    <parameter name="TELEFONO" class="java.lang.String"/>
    <parameter name="FECHA_EMISION" class="java.lang.String"/>

    <field name="fecha" class="java.lang.String"/>
    <field name="motivo" class="java.lang.String"/>
    <field name="temperatura" class="java.lang.String"/>
    <field name="peso" class="java.lang.String"/>
    <field name="comentarios" class="java.lang.String"/>

    <title>
        <band height="150">
            <textField>
                <reportElement x="0" y="0" width="360" height="22"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{NEGOCIO}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Etiqueta" x="0" y="22" width="360" height="18"/>
                <textElement><font size="12"/></textElement>
                <text><![CDATA[Historial de consultas]]></text>
            </staticText>
            <textField>
                <reportElement x="360" y="0" width="155" height="16"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Expediente N.º " + $P{NUM_EXPEDIENTE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="16" width="155" height="16" forecolor="#636E72"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Emitido: " + $P{FECHA_EMISION}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="46" width="515" height="1" forecolor="#018081"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>

            <!-- Datos del paciente: dos columnas de etiqueta + valor -->
            <staticText><reportElement style="Etiqueta" x="0" y="56" width="75" height="16"/><text><![CDATA[Paciente]]></text></staticText>
            <textField><reportElement x="75" y="56" width="180" height="16"/><textFieldExpression><![CDATA[$P{PACIENTE}]]></textFieldExpression></textField>
            <staticText><reportElement style="Etiqueta" x="265" y="56" width="75" height="16"/><text><![CDATA[Especie]]></text></staticText>
            <textField><reportElement x="340" y="56" width="175" height="16"/><textFieldExpression><![CDATA[$P{ESPECIE}]]></textFieldExpression></textField>

            <staticText><reportElement style="Etiqueta" x="0" y="74" width="75" height="16"/><text><![CDATA[Raza]]></text></staticText>
            <textField><reportElement x="75" y="74" width="180" height="16"/><textFieldExpression><![CDATA[$P{RAZA}]]></textFieldExpression></textField>
            <staticText><reportElement style="Etiqueta" x="265" y="74" width="75" height="16"/><text><![CDATA[Sexo]]></text></staticText>
            <textField><reportElement x="340" y="74" width="175" height="16"/><textFieldExpression><![CDATA[$P{SEXO}]]></textFieldExpression></textField>

            <staticText><reportElement style="Etiqueta" x="0" y="92" width="75" height="16"/><text><![CDATA[Edad]]></text></staticText>
            <textField><reportElement x="75" y="92" width="180" height="16"/><textFieldExpression><![CDATA[$P{EDAD}]]></textFieldExpression></textField>
            <staticText><reportElement style="Etiqueta" x="265" y="92" width="75" height="16"/><text><![CDATA[Propietario]]></text></staticText>
            <textField><reportElement x="340" y="92" width="175" height="16"/><textFieldExpression><![CDATA[$P{PROPIETARIO}]]></textFieldExpression></textField>

            <staticText><reportElement style="Etiqueta" x="265" y="110" width="75" height="16"/><text><![CDATA[Teléfono]]></text></staticText>
            <textField><reportElement x="340" y="110" width="175" height="16"/><textFieldExpression><![CDATA[$P{TELEFONO}]]></textFieldExpression></textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement style="Encabezado" x="0" y="0" width="70" height="22"/><box leftPadding="5"/><textElement verticalAlignment="Middle"/><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement style="Encabezado" x="70" y="0" width="200" height="22"/><box leftPadding="5"/><textElement verticalAlignment="Middle"/><text><![CDATA[Motivo]]></text></staticText>
            <staticText><reportElement style="Encabezado" x="270" y="0" width="65" height="22"/><box rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Temp.]]></text></staticText>
            <staticText><reportElement style="Encabezado" x="335" y="0" width="55" height="22"/><box rightPadding="5"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Peso]]></text></staticText>
            <staticText><reportElement style="Encabezado" x="390" y="0" width="125" height="22"/><box leftPadding="5"/><textElement verticalAlignment="Middle"/><text><![CDATA[Comentarios]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField textAdjust="StretchHeight">
                <reportElement style="Fila" stretchType="RelativeToTallestObject" x="0" y="0" width="70" height="20"/>
                <box topPadding="4" leftPadding="5" bottomPadding="4"/>
                <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="Fila" stretchType="RelativeToTallestObject" x="70" y="0" width="200" height="20"/>
                <box topPadding="4" leftPadding="5" bottomPadding="4" rightPadding="5"/>
                <textFieldExpression><![CDATA[$F{motivo}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="Fila" stretchType="RelativeToTallestObject" x="270" y="0" width="65" height="20"/>
                <box topPadding="4" bottomPadding="4" rightPadding="5"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{temperatura}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="Fila" stretchType="RelativeToTallestObject" x="335" y="0" width="55" height="20"/>
                <box topPadding="4" bottomPadding="4" rightPadding="5"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{peso}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="Fila" stretchType="RelativeToTallestObject" x="390" y="0" width="125" height="20"/>
                <box topPadding="4" leftPadding="5" bottomPadding="4" rightPadding="5"/>
                <textFieldExpression><![CDATA[$F{comentarios}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <line>
                <reportElement x="0" y="2" width="515" height="1" forecolor="#B2BEC3"/>
            </line>
            <textField>
                <reportElement x="0" y="6" width="300" height="14" forecolor="#636E72"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{NEGOCIO} + " · " + $P{PACIENTE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="315" y="6" width="160" height="14" forecolor="#636E72"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="475" y="6" width="40" height="14" forecolor="#636E72"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="30">
            <textField>
                <reportElement style="Etiqueta" x="0" y="10" width="515" height="16"/>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT} == 0
    ? "Este paciente todavía no tiene consultas registradas."
    : "Total: " + $V{REPORT_COUNT} + ($V{REPORT_COUNT} == 1 ? " consulta" : " consultas")]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
