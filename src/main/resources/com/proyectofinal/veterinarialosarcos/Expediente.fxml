<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.proyectofinal.veterinarialosarcos.controllers.ExpedienteController"
            fitToWidth="true"
            prefWidth="760"
            prefHeight="680"
            stylesheets="@expediente.css">

    <VBox spacing="20"
          styleClass="main-container">

        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Button text="← Atrás"
                onAction="#volver"
                styleClass="volver-button"/>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="lblTitulo"
                   text="Expediente Clínico"
                   styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblNumero" styleClass="numero"/>
        </HBox>

        <GridPane hgap="30" vgap="8" styleClass="info-card">
            <columnConstraints>
                <ColumnConstraints minWidth="90"/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="90"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Paciente" styleClass="dato" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblPaciente" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Especie" styleClass="dato" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <Label fx:id="lblEspecie" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Raza" styleClass="dato" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblRaza" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Sexo" styleClass="dato" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <Label fx:id="lblSexo" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <Label text="Edad" styleClass="dato" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblEdad" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Propietario" styleClass="dato" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <Label fx:id="lblPropietario" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

            <Label text="Teléfono" styleClass="dato" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
            <Label fx:id="lblTelefono" text="—" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
        </GridPane>

        <VBox spacing="8"
              styleClass="section-card">
            <Label text="💉 Historial de Vacunación"
                   styleClass="section-title"/>
            <TextArea fx:id="txtVacunas"
                      wrapText="true"
                      promptText="Ej.: 12/03/2026 - Rabia (refuerzo)"
                      prefHeight="110"/>
        </VBox>

        <VBox spacing="8"
              styleClass="section-card">
            <Label text="💊 Historial de Desparasitación"
                   styleClass="section-title"/>
            <TextArea fx:id="txtDesparasitacion"
                      wrapText="true"
                      prefHeight="110"/>
        </VBox>

        <VBox spacing="8"
              styleClass="section-card">
            <Label text="🐛 Control de Parásitos"
                   styleClass="section-title"/>
            <TextArea fx:id="txtParasitos"
                      wrapText="true"
                      prefHeight="110"/>
        </VBox>

        <VBox spacing="8"
              styleClass="section-card">
            <Label text="📝 Observaciones"
                   styleClass="section-title"/>
            <TextArea fx:id="txtObservaciones"
                      wrapText="true"
                      prefHeight="150"/>
        </VBox>

        <Button text="Guardar Cambios"
                onAction="#guardar"
                maxWidth="Infinity"
                styleClass="save-button"/>

    </VBox>

</ScrollPane>
