<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Modificar los datos del propietario de un paciente -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.proyectofinal.veterinarialosarcos.controllers.EditarPropietarioController"
      spacing="14"
      stylesheets="@nuevoPaciente.css"
      styleClass="root-container"
      style="-fx-pref-width: 380; -fx-pref-height: 360;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Editar propietario"
           styleClass="title"/>

    <Label fx:id="lblPaciente"
           styleClass="section-title"/>

    <Label text="Nombre"/>
    <TextField fx:id="txtNombreOwner"
               promptText="Nombre"/>

    <Label text="Dirección"/>
    <TextField fx:id="txtDireccion"
               promptText="Dirección"/>

    <Label text="Teléfono"/>
    <HBox spacing="6">
        <ComboBox fx:id="cmbCodigoTelefono"
                  styleClass="codigo-telefono"/>
        <TextField fx:id="txtTelefono"
                   promptText="Teléfono"
                   styleClass="numero-telefono"/>
    </HBox>

    <Separator/>

    <HBox spacing="15"
          alignment="CENTER">

        <Button text="Guardar cambios"
                onAction="#guardar"
                styleClass="save-button"/>

        <Button text="Cancelar"
                onAction="#cancelar"
                styleClass="cancel-button"/>

    </HBox>

</VBox>
