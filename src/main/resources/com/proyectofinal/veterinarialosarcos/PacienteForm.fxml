<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.proyectofinal.veterinarialosarcos.controllers.PacienteFormController"
      stylesheets="@login.css, @pacientes.css"
      styleClass="formulario"
      spacing="16"
      prefWidth="520">

    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <Label fx:id="lblTitulo" styleClass="title"/>

    <!-- Datos del paciente -->
    <Label text="Paciente" styleClass="seccion"/>
    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <TextField fx:id="txtNombre" promptText="Nombre"
                   styleClass="input" maxWidth="Infinity"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtExpediente" promptText="Nº de expediente"
                   styleClass="input" maxWidth="Infinity"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <ComboBox fx:id="cmbEspecie" promptText="Especie"
                  styleClass="input" maxWidth="Infinity"
                  GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtRaza" promptText="Raza (opcional)"
                   styleClass="input" maxWidth="Infinity"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <ComboBox fx:id="cmbGenero" promptText="Género"
                  styleClass="input" maxWidth="Infinity"
                  GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <DatePicker fx:id="dpFechaNac" promptText="Fecha de nacimiento"
                    styleClass="input" maxWidth="Infinity"
                    GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <!-- Datos del dueño -->
    <Label text="Dueño" styleClass="seccion"/>
    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <TextField fx:id="txtDueno" promptText="Nombre del dueño"
                   styleClass="input" maxWidth="Infinity"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtTelefono" promptText="Teléfono"
                   styleClass="input" maxWidth="Infinity"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
    </GridPane>

    <Label fx:id="lblMensaje"
           wrapText="true"
           visible="false"
           managed="false"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancelar"
                onAction="#cancelar"
                cancelButton="true"
                styleClass="link-button"/>
        <Button text="Guardar"
                onAction="#guardar"
                defaultButton="true"
                styleClass="boton-accion"/>
    </HBox>

</VBox>
