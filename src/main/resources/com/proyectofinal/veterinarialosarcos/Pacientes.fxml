<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.proyectofinal.veterinarialosarcos.controllers.PacientesController"
            stylesheets="@login.css, @pacientes.css"
            styleClass="background"
            prefWidth="900"
            prefHeight="600">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <center>
        <VBox spacing="16" styleClass="login-card">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- Encabezado: título, total de pacientes y acciones -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label fx:id="lblBienvenida" styleClass="title"/>
                    <Label fx:id="lblTotal" styleClass="subtitle"/>
                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="Cerrar sesión"
                        onAction="#cerrarSesion"
                        styleClass="link-button"/>
            </HBox>

            <TableView fx:id="tblPacientes"
                       styleClass="tabla-pacientes"
                       VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>

                <placeholder>
                    <Label fx:id="lblPlaceholder" styleClass="subtitle"/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre"/>
                    <TableColumn fx:id="colDueno" text="Dueño"/>
                    <TableColumn fx:id="colUltimaCita" text="Última cita"/>
                    <TableColumn fx:id="colExpediente" text="Expediente"/>
                </columns>
            </TableView>

            <!-- Acciones sobre los pacientes (doble clic en una fila = actualizar) -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Doble clic en un paciente para actualizarlo"
                       styleClass="subtitle"/>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="Agregar"
                        onAction="#agregar"
                        styleClass="boton-accion"/>

                <Button fx:id="btnEliminar"
                        text="Eliminar"
                        onAction="#eliminar"
                        styleClass="boton-eliminar"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
