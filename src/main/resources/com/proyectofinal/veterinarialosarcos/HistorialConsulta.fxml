<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.proyectofinal.veterinarialosarcos.controllers.HistorialConsultasController"
        stylesheets="@historialConsultas.css">

    <top>

        <VBox spacing="10"
              styleClass="header-container">

            <Button text="← Volver"
                    onAction="#volver"/>

            <Label fx:id="lblTitulo"
                   text="Expediente de Rocky"
                   styleClass="title"/>

            <GridPane hgap="20"
                      vgap="8">

                <Label text="Paciente:"/>
                <Label fx:id="lblPaciente"
                       GridPane.columnIndex="1"/>

                <Label text="Especie:"
                       GridPane.rowIndex="1"/>

                <Label fx:id="lblEspecie"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>

                <Label text="Propietario:"
                       GridPane.rowIndex="2"/>

                <Label fx:id="lblOwner"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>

            </GridPane>

        </VBox>

    </top>